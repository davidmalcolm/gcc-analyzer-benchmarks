"""Entry point: run gab straight out of a checkout, with no install step.

Equivalent to `python3 -m gab` from the repo root.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from gab.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
